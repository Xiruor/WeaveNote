generator client {
  provider = "prisma-client"
  // 生成物刻意**不放 src/**：每次 prisma generate 都会重写这一整目录（30+ 文件），
  // 放在源码树里会让 dev server 的模块图整片失效、把所有页面重新编译一遍，
  // 也把 src/ 搅得不像源码。prisma/ 下与 schema、手工 SQL 迁移脚本同处一处更好找。
  // 引用方式：src/ 内用 "@/prisma-generated/client"（见 tsconfig paths），
  // scripts/ 与 prisma/seed.ts 用相对路径。
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  password      String?
  bio           String?
  theme         String   @default("system")
  /// VIP：不受每日 AI token 限额约束（用量仍照常记账）。
  /// 这不是安全边界——它只影响 usage.ts 的限额判断，不改变任何鉴权。
  vip           Boolean  @default(false)
  /// 上次被弹「每日公告」的日期，格式 YYYY-MM-DD，由客户端按**自己的本地时区**写入。
  /// 放服务端是为了跨设备 / 跨标签页去重；服务端不解释这个值，只做字符串相等比较。
  announcementSeenOn String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ── 鉴权 ──
  sessions         Session[]
  accounts         Account[]

  // ── 记忆：v1 UserMemory（只读回滚点）+ v2 Memory 三件套 ──
  memories         UserMemory[]
  memoryItems      Memory[]
  memoryEvents     MemoryEvent[]
  memoryCandidates MemoryCandidate[]

  // ── 对话与通知 ──
  conversations    Conversation[]
  notifications    Notification[]

  // ── 笔记库 ──
  folders          Folder[]
  notes            Note[]
  noteChunks       NoteChunk[]
  noteProposals    NoteProposal[]
  noteVersions     NoteVersion[]

  // ── 用量记账 ──
  tokenUsages      TokenUsage[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id           String   @id @default(cuid())
  userId       String
  providerId   String
  accountId    String
  provider     String   @default("credential")
  password     String?
  accessToken  String?
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("account")
}

model AvatarChange {
  id        String   @id @default(cuid())
  userId    String
  image     String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("avatarchange")
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  /**
   * 界面来源：workspace 跨笔记工作台 / note 笔记编辑器侧栏；refId = noteId
   */
  surface   String   @default("workspace")
  /**
   * surface=note 时为笔记 id
   */
  refId     String?
  title     String   @default("新对话")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ConversationMessage[]
  agentState AgentState?

  @@index([userId, updatedAt])
  // 对话的访问路径：userId + surface(+refId) 过滤后按 updatedAt 倒序
  @@index([userId, surface, refId, updatedAt])
  @@map("conversation")
}

model ConversationMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  /**
   * 纯文本内容。**仍然是有效契约，不能停写**：对话标题生成
   * （api/conversations/[id]/title）和 createPlan 的 conversationHint 都按字符串读它。
   */
  content        String
  /**
   * 结构化的消息片段（text / tool），用来在界面上渲染「AI 调用了什么工具」。
   *
   * 为什么另开一列而不是把 content 改成 JSON：content 有两处按字符串读的调用方，
   * 改了要一起动；而且 2026-10 之前的存量行只有 content，nullable 的 parts 让它们
   * 自然回落到纯文本渲染，无需回填。
   *
   * ⚠️ 形状是 src/lib/ai/parts.ts 的 ViewPart，**不是** AI SDK 的 UIMessagePart
   * 原样落库：工具的 input/output 在落库前已被压成一条短摘要，否则 updateDocument
   * 的整篇文档（zod 上限 10 万字符）会被复制进每一条消息行。
   */
  parts          Json?
  /**
   * AI SDK 的原始 parts（text / tool-*），用于后续轮次重建 tool-call/tool-result
   * 配对。parts 是展示摘要，不能拿来还原工具调用；rawParts 会按单条限制裁剪
   * 超大 input/output，避免 updateDocument 的整篇文档反复入库。
   */
  rawParts       Json?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("conversationmessage")
}

/**
 * 会话级短期记忆。
 *
 * 与 Conversation 一对一：
 *   summary                    较早对话的滚动摘要（替换式）
 *   workingMemory              当前任务的重要信息
 *   todoList                   当前任务进度
 *   compressedThroughMessageId 已压缩到的最后一条原始消息
 *   version                    乐观锁，避免并发压缩互相覆盖
 *
 * 原始 ConversationMessage 永远保留；这里只存压缩结果和会话状态。
 */
model AgentState {
  id                         String   @id @default(cuid())
  conversationId             String   @unique
  summary                    String   @default("")
  workingMemory              Json     @default("[]")
  todoList                   Json     @default("[]")
  compressedThroughMessageId String?
  version                    Int      @default(0)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("agentstate")
}

model UserMemory {
  id         String                      @id @default(cuid())
  userId     String
  type       String                      @default("fact")
  content    String
  embedding  Unsupported("vector(1024)")?
  importance Float                       @default(0.5)
  confidence Float                       @default(0.5)
  lastUsed   DateTime?
  createdAt  DateTime                    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, importance])
  @@index([userId, lastUsed])
  @@map("usermemory")
}

// ============================================================
// Memory v2：长期记忆实体 + 不可变事件日志 + 候选/任务队列
//
// 与 UserMemory 的关系：
//   · usermemory 是 v1 表，迁移完成后保留为只读回滚点，不再由应用写入；
//   · memory 是 v2 的唯一 active 实体表，embedding 仍是 vector(1024)；
//   · 额外的“同用户同 normalizedKey 只能有一条 active”部分唯一索引、
//     以及 HNSW 向量索引，Prisma 表达不了，见 prisma/add-memory-v2.sql。
//
// 生命周期：active / superseded / expired / archived / deleted。
// 任何变更都必须同时写一条 MemoryEvent，不允许无痕修改。
// ============================================================

model Memory {
  id            String   @id @default(cuid())
  userId        String
  /// 迁移幂等键：v1 UserMemory.id；v2 新数据为 null
  legacyId      String?  @unique

  /// goal | skill | weakness | preference | habit | fact
  kind          String
  /// 单条记忆正文；服务端对 v2 新写入强制 <= 200 字符（存量数据保持原样）
  content       String
  /// 冲突/去重键，如 skill:react；可选
  normalizedKey String?

  /// active | superseded | expired | archived | deleted
  status        String   @default("active")

  importance    Float    @default(0.5)
  confidence    Float    @default(0.5)

  validFrom     DateTime?
  validTo       DateTime?
  lastConfirmedAt DateTime @default(now())

  /// 三种“使用”信号刻意分开：进入候选池 / 真正注入上下文 / 工具主动读取
  lastRetrievedAt DateTime?
  lastInjectedAt  DateTime?
  injectedCount   Int      @default(0)
  toolReadCount   Int      @default(0)

  /// 被哪条新记忆覆盖（指向 memory.id）
  supersedesId  String?

  /// user_statement | user_correction | note | consolidation | legacy | user_edit
  sourceType    String
  sourceConversationId String?
  sourceMessageId      String?

  embedding     Unsupported("vector(1024)")?
  embeddingModel String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, kind])
  @@index([userId, status, importance])
  @@index([userId, status, updatedAt])
  @@index([userId, normalizedKey])
  @@map("memory")
}

model MemoryEvent {
  id        String   @id @default(cuid())
  userId    String
  memoryId  String?
  /// add | update | supersede | merge | expire | archive | restore | delete | import | noop
  action    String
  /// extractor | user | system | consolidation | migration
  actor     String
  before    Json?
  after     Json?
  /// 用户原话摘录；正常抽取写入时强制存在
  evidence  String?
  sourceConversationId String?
  sourceMessageId      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([memoryId, createdAt])
  @@map("memoryevent")
}

model MemoryCandidate {
  id             String   @id @default(cuid())
  userId         String
  conversationId String?
  /// 本轮助手消息 id；唯一，保证同一条消息只抽取一次
  messageId      String   @unique
  /// pending | running | ready | done | noop | failed | skipped
  status         String   @default("pending")
  attempts       Int      @default(0)
  model          String?
  rawOutput      Json?
  /// 经过服务端校验后的操作列表
  operations     Json?
  error          String?
  createdAt      DateTime @default(now())
  processedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@map("memorycandidate")
}

// ============================================================
// 笔记库：Folder（文件夹树）/ Note（笔记）/ NoteChunk（向量检索切片）/ NoteProposal（AI 改稿提案）
//
// NoteChunk.embedding 的 HNSW 向量索引、Note 标题/正文的 trgm 关键词索引
// Prisma 表达不了，见 prisma/add-note-search.sql。
// ============================================================

model Folder {
  id        String    @id @default(cuid())
  userId    String
  name      String
  parentId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Folder?   @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]  @relation("FolderTree")
  notes     Note[]

  @@index([userId, parentId])
  @@map("folder")
}

model Note {
  id        String    @id @default(cuid())
  userId    String
  folderId  String?
  title     String
  content   String    @default("")
  pinned    Boolean   @default(false)
  /// 已索引正文的 sha256；与当前 content 不等 = 语义索引落后，检索时懒建
  indexHash String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder    Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  chunks    NoteChunk[]
  proposals NoteProposal[]
  versions  NoteVersion[]

  @@index([userId, updatedAt])
  @@index([userId, folderId])
  @@map("note")
}

model NoteChunk {
  id         String   @id @default(cuid())
  noteId     String
  userId     String
  chunkIndex Int
  /// 所属标题路径（如 "## 分布式 > ### Raft"），来源引用与上下文回填用
  heading    String?
  content    String
  embedding  Unsupported("vector(1024)")?
  createdAt  DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([userId])
  @@map("notechunk")
}

model NoteProposal {
  id             String    @id @default(cuid())
  userId         String
  noteId         String
  conversationId String?
  newTitle       String?
  newContent     String
  /// 提案时的内容 sha256，应用时校验，防止覆盖用户后来的编辑
  baseHash       String
  reason         String?
  status         String    @default("pending") // pending | accepted | rejected | stale
  createdAt      DateTime  @default(now())
  decidedAt      DateTime?

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([noteId, status])
  @@map("noteproposal")
}

/// 应用提案 / AI 改稿前的正文快照。版本历史 UI 归 M5，M3 只在 apply 时写快照。
model NoteVersion {
  id        String   @id @default(cuid())
  noteId    String
  userId    String
  title     String
  content   String
  createdAt DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([noteId, createdAt])
  @@map("noteversion")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("reminder")
  title     String
  content   String
  read      Boolean  @default(false)
  actionUrl String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([userId, type])
  @@map("notification")
}

// ── 用户 AI token 用量（每日限额；模型池统一记账） ──
model TokenUsage {
  id           String   @id @default(cuid())
  userId       String
  // 记账口径：workspace | note | title | memory | note-index（交互面 workspace/note 计入限额，系统面不计）
  surface      String
  tier         String // low | high
  model        String // 实际使用模型
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  totalTokens  Int      @default(0)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("tokenusage")
}

/// 全站公告 —— 不按用户存，一份所有人看同一份
model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String // Markdown
  /// 是否对用户可见。发错了改成 false 即可撤下，不必删数据
  published Boolean  @default(true)
  /// 是否参与「每天首次进入弹一次」。false 则只出现在铃铛的公告列表里
  popup     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt])
  @@map("announcement")
}
